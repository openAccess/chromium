static_library("warc") {
  sources = [
    "cdxj.cc",
    "cdxj.h",
    "gzip_member_reader.cc",
    "gzip_member_reader.h",
    "gzip_member_writer.cc",
    "gzip_member_writer.h",
    "surt.cc",
    "surt.h",
    "wacz_reader.cc",
    "wacz_reader.h",
    "warc_body_spill.cc",
    "warc_body_spill.h",
    "warc_record.cc",
    "warc_record.h",
    "warc_record_parser.cc",
    "warc_record_parser.h",
    "warc_writer.cc",
    "warc_writer.h",
  ]

  deps = [
    "//base",
    "//components/base32",
    "//crypto",
    "//third_party/zlib",
    "//third_party/zlib/google:compression_utils",
    "//url",
  ]
}

# Serving an archive rather than writing one. Kept apart from the format
# library so that capturing does not drag in what only replay needs.
static_library("replay") {
  sources = [
    "wacz_collection.cc",
    "wacz_collection.h",
    "wacz_url_loader_factory.cc",
    "wacz_url_loader_factory.h",
  ]

  deps = [
    ":warc",
    "//base",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "warc_test_util.cc",
    "warc_test_util.h",
  ]

  deps = [
    ":warc",
    "//base",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "cdxj_unittest.cc",
    "gzip_member_reader_unittest.cc",
    "gzip_member_writer_unittest.cc",
    "surt_unittest.cc",
    "wacz_collection_unittest.cc",
    "wacz_reader_unittest.cc",
    "wacz_url_loader_factory_unittest.cc",
    "warc_record_parser_unittest.cc",
    "warc_record_unittest.cc",
    "warc_writer_unittest.cc",
  ]

  deps = [
    ":replay",
    ":test_support",
    ":warc",
    "//base",
    "//base/test:test_support",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//testing/gtest",
    "//third_party/zlib/google:zip",
  ]
}
