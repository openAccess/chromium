# Whether a partition or a tab is a replay one, apart from the rest of replay
# so that what only needs to tell -- tab helpers, session restore -- can ask
# without depending on //chrome/browser.
source_set("partition") {
  sources = [
    "replay_partition.cc",
    "replay_partition.h",
  ]

  public_deps = [ "//content/public/browser" ]
}

# What each replay tab asked its archive for and what became of it, apart from
# the rest of replay so that the UI showing it need not depend on
# //chrome/browser.
source_set("log") {
  sources = [
    "replay_log.cc",
    "replay_log.h",
  ]

  public_deps = [
    "//base",
    "//components/warc:replay",
    "//content/public/browser",
  ]
}
