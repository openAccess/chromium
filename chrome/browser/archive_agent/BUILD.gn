# The archive panel's assistant: Pi (pi.dev) run as a child process, with
# tools that can only look at the tab it belongs to.
source_set("archive_agent") {
  sources = [
    "archive_agent.cc",
    "archive_agent.h",
  ]
  public_deps = [ "//base" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "archive_agent_unittest.cc" ]
  deps = [
    ":archive_agent",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
